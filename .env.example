# Copy this file to .env and fill it in. Never commit .env.

# ---- Required ----
# Create a bot with @BotFather.
BOT_TOKEN=
# From https://my.telegram.org -> API development tools.
API_ID=
API_HASH=
# A Pyrogram (Kurigram) session string for the assistant account, the user
# account that joins voice chats and plays the audio.
ASSISTANT_SESSION=

# ---- Optional ----
# Your numeric Telegram user id. Needed for owner-only commands.
OWNER_ID=
# Public https URL of this app plus /webhook. Leave empty to receive updates
# by polling instead, which needs no public address.
WEBHOOK_URL=
PORT=8000

# MongoDB. Without it the bot still plays music, but playlists, premium users,
# broadcast and /clone are switched off.
MONGO_URI=
MONGO_DB=kustmusic

# YouTube usually blocks servers without cookies. Paste a Netscape cookies
# file here as text, or point COOKIES_FILE at one.
COOKIES=
COOKIES_FILE=
# Extra flags for every yt-dlp call, for example a proxy: --proxy http://host:port
YTDLP_ARGS=

# Display name given to the assistant account. Empty leaves it alone.
ASSISTANT_NAME=

# Links shown in the bot's buttons.
COMMUNITY_URL=
SUPPORT_URL=
SUPPORT_USERNAME=
GITHUB_URL=
UPDATES_URL=
# Set to true to let the bot post an occasional "add me to your group" note.
PROMO_ENABLED=

# Tuning (defaults are fine).
CACHE_MAX_MB=512
IDLE_LEAVE_TIMEOUT_SECONDS=180
IDLE_GROUP_LEAVE_SECONDS=259200
SWEEP_KEEP_CHATS=
PLAY_REQUEST_BUDGET_SECONDS=150
CONNECT_WAIT_SECONDS=
SESSION_START_DELAY_SECONDS=0
